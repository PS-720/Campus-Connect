# CampusConnect AI Backend Configuration

# Server
SERVER_PORT=8080

# MongoDB Configuration
# Local default: mongodb://localhost:27017/campusconnect
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusconnect

# JWT Security
# Must be at least 256 bits (32 bytes) long base64/hex or plaintext string for HS256/HS384/HS512
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Max Sizes
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=30MB

# Spring AI / Ollama Configuration (Future / Optional Phase)
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
